# Copy to .env at the repo root (or to examples/assistant/.env for just the assistant
# demo) and fill in the values. The demo API (examples/demo_common/host.py) reads this
# file after the environment and the example's own .env. Never put a real key in this
# file.
#
# The agent speaks the Anthropic Messages API: the SDK posts to
# "{ANTHROPIC_BASE_URL}/v1/messages" with SSE streaming. An OpenAI-format endpoint
# (/v1/chat/completions) does not work; a multi-format gateway must expose its
# Anthropic-compatible endpoint.

# -- Endpoint. Leave blank for the official API. For a gateway, write the host (and any
# path prefix) WITHOUT /v1 — the SDK appends /v1/messages itself.
ANTHROPIC_BASE_URL=

# -- Credential; fill one, leave the other blank. AUTH_TOKEN sends a Bearer header,
# API_KEY sends x-api-key.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=

# -- Models (the assistant example's API only). Chat runs on SHOPPING_MODEL; post-turn
# memory extraction on SHOPPING_MEMORY_MODEL. Blank keeps the defaults
# (claude-sonnet-5 / claude-haiku-4-5-20251001); set both when the gateway serves its
# own model ids.
SHOPPING_MODEL=
SHOPPING_MEMORY_MODEL=

# -- Thinking effort for the chat model: low, medium, high, xhigh, max, or off.
# Blank keeps the default (low).
SHOPPING_THINKING_EFFORT=

# -- Anonymous experience storage. Enable Anonymous Sign-ins and apply
# supabase/migrations/001_agent_experience.sql and 002_outdoor_cart_currency.sql
# in the Supabase project first (once each, in order).
# The browser receives only the URL and publishable/anon key. Keep service_role private.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# A legacy anon JWT may be used instead of the publishable key.
SUPABASE_ANON_KEY=
# Use the server-side legacy service_role JWT from this same project.
SUPABASE_SERVICE_ROLE_KEY=

# -- Public deployment (deploy/compose.yaml). Bare domain, no scheme or path.
SHOPPING_DOMAIN=
# For manual deployment, allow the domain in the API Host header. Compose sets this.
DEMO_ALLOWED_HOSTS=

# -- Model budget. Set the window for the actual chat AND summary model served.
# The runtime conservatively budgets UTF-8 text, keeps whole recent exchanges and
# stores summaries separately from the immutable completed-turn archive.
SHOPPING_CONTEXT_WINDOW_TOKENS=131072
SHOPPING_CONTEXT_RESERVE_TOKENS=4096
SHOPPING_CONTEXT_RECENT_TURNS=4
SHOPPING_CONTEXT_SUMMARY_TIMEOUT_S=25

# -- One API worker. Limits bound anonymous model use; daily quotas persist in UTC.
SHOPPING_MAX_CONCURRENT_TURNS=4
SHOPPING_TURNS_PER_MINUTE=12
SHOPPING_USER_DAILY_TURNS=100
SHOPPING_GLOBAL_DAILY_TURNS=1000
SHOPPING_MEMORY_WAIT_S=1.5
SHOPPING_MEMORY_TIMEOUT_S=25
SHOPPING_MEMORY_RETRIES=4
