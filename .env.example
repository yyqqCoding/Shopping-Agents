# Copy to .env at the repo root (or to examples/assistant/.env for just the assistant
# demo) and fill in the values. The demo API (examples/demo_common/host.py) reads this
# file after the environment and the example's own .env. Never put a real key in this
# file.
#
# The agent speaks the Anthropic Messages API: the SDK posts to
# "{ANTHROPIC_BASE_URL}/v1/messages" with SSE streaming. An OpenAI-format endpoint
# (/v1/chat/completions) does not work; a multi-format gateway must expose its
# Anthropic-compatible endpoint.

# -- Endpoint. Leave blank for the official API. For a gateway, write the host (and any
# path prefix) WITHOUT /v1 — the SDK appends /v1/messages itself.
ANTHROPIC_BASE_URL=

# -- Credential; fill one, leave the other blank. AUTH_TOKEN sends a Bearer header,
# API_KEY sends x-api-key.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=

# -- Models (the assistant example's API only). Chat runs on SHOPPING_MODEL; post-turn
# legacy fact extraction on SHOPPING_MEMORY_MODEL. Session notes, compaction and
# topic-memory forks inherit SHOPPING_MODEL. Blank keeps the defaults
# (claude-sonnet-5 / claude-haiku-4-5-20251001); set both when the gateway serves its
# own model ids.
SHOPPING_MODEL=
SHOPPING_MEMORY_MODEL=

# -- Thinking effort for the chat model: low, medium, high, xhigh, max, or off.
# Blank keeps the default (low).
SHOPPING_THINKING_EFFORT=

# -- Local anonymous experience storage: credentials, conversations and memory.
# The deployment mounts a persistent volume at /var/lib/shopping-agent.
# Local development defaults to .shopping-data under the repository root.
SHOPPING_DATA_DIR=

# -- Catalog, stock, carts and orders. `java` calls the commerce service
# (commerce-service/, deployed by scripts/deploy_commerce.sh); `json` runs the fixtures
# in-process with carts in memory. Blank picks java when COMMERCE_SERVICE_URL is set.
CATALOG_BACKEND=java
# The commerce server's private address, and the token from its deploy/commerce/.env.
COMMERCE_SERVICE_URL=http://172.24.65.233:8080
COMMERCE_SERVICE_TOKEN=
SHOPPING_SEARCH_PAGE_SIZE=6

# -- Public deployment (deploy/compose.yaml). Bare domain, no scheme or path.
SHOPPING_DOMAIN=
# For manual deployment, allow the domain in the API Host header. Compose sets this.
DEMO_ALLOWED_HOSTS=

# -- Model budget. Set the window for the actual chat AND summary model served.
# The runtime conservatively budgets UTF-8 text, keeps whole recent exchanges and
# stores summaries separately from the immutable completed-turn archive. A 13k safety
# floor is applied on normal windows even if the extra reserve below is smaller.
SHOPPING_CONTEXT_WINDOW_TOKENS=131072
SHOPPING_CONTEXT_RESERVE_TOKENS=4096
SHOPPING_CONTEXT_SUMMARY_TIMEOUT_S=120
# Actual model output capacity, independent of a normal chat reply's max_tokens.
# Automatic compression reserves min(this value, 20000) plus a 13000-token buffer.
SHOPPING_MODEL_MAX_OUTPUT_TOKENS=20000
# false follows Anthropic: fresh input and cache counters are disjoint.
# Set true only if the gateway documents input_tokens as already including cache.
SHOPPING_USAGE_INPUT_INCLUDES_CACHE=false
SHOPPING_SESSION_NOTE_INIT_TOKENS=10000
SHOPPING_SESSION_NOTE_GROWTH_TOKENS=5000
SHOPPING_SESSION_NOTE_TOOL_CALLS=3
SHOPPING_SESSION_NOTE_KEEP_MIN_TOKENS=10000
SHOPPING_SESSION_NOTE_KEEP_MIN_TEXT_MESSAGES=5
SHOPPING_SESSION_NOTE_KEEP_MAX_TOKENS=40000
SHOPPING_TIME_BASED_MICROCOMPACT=false
SHOPPING_MICROCOMPACT_GAP_MINUTES=60
SHOPPING_MICROCOMPACT_KEEP_RECENT=5

# -- One API worker. Limits bound anonymous model use; daily quotas persist in UTC.
SHOPPING_MAX_CONCURRENT_TURNS=4
SHOPPING_TURNS_PER_MINUTE=12
SHOPPING_USER_DAILY_TURNS=100
SHOPPING_GLOBAL_DAILY_TURNS=1000
SHOPPING_MEMORY_WAIT_S=1.5
SHOPPING_MEMORY_TIMEOUT_S=25
SHOPPING_MEMORY_RETRIES=4
SHOPPING_SESSION_NOTE_TIMEOUT_S=120

# -- Typed local long-term memory. Extraction and Dream inherit the chat model and
# cache prefix; this selector is the source snapshot's separate relevance-model role.
# Blank uses SHOPPING_MODEL. The selector requires JSON-schema output support.
SHOPPING_MEMORY_SELECTOR_MODEL=
SHOPPING_MEMORY_EXTRACT=true
SHOPPING_MEMORY_PREFETCH=false
SHOPPING_MEMORY_DREAM=true
SHOPPING_MEMORY_DREAM_MAX_TURNS=30
# These are initial settings; /memory persists per-user overrides. Index mode is
# active with prefetch=false. Daily logs and Agent scopes are configured there.
