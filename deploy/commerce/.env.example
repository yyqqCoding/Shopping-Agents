# Copy to deploy/commerce/.env on the commerce server and fill in. Never commit it.

# MySQL. Only the commerce container connects; no port is published.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# The bearer token the agent API sends; the same value goes in the agent server's .env.
# Generate one with: openssl rand -hex 32
COMMERCE_SERVICE_TOKEN=

# This server's private address; the service listens there only.
COMMERCE_BIND_IP=172.24.65.233

# DEBUG logs every mapper statement with its parameters; INFO does not.
COMMERCE_LOG_LEVEL=DEBUG
